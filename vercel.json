{
  "version": 2,
  "builds": [
    { "src": "api/index.php", "use": "vercel-php@0.7.4" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/build/(.*)", "dest": "/public/build/$1" },
    { "src": "/(.+\\.(?:png|jpe?g|gif|svg|ico|webp|css|js|txt|xml|woff2?|ttf))", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}